---
export const prerender = true;

import { getCollection } from "astro:content";
import AboutCta from "~/components/AboutPage/AboutCta.astro";
import AboutIntro from "~/components/AboutPage/AboutIntro.astro";
import Chapter from "~/components/AboutPage/Chapter.astro";
import TeamMember from "~/components/AboutPage/TeamMember.astro";
import Layout from "~/layouts/Layout.astro";

const aboutEntries = await getCollection("about");
const membersEntries = await getCollection("members");
const dogsEntries = await getCollection("dogs");

// Past → present → future
const chapterOrder = ["story", "mission", "vision"] as const;
const chapterLayouts = ["wide", "right", "left"] as const;
const chapters = chapterOrder
	.map((id) => aboutEntries.find((entry) => entry.id === id))
	.filter((entry) => entry !== undefined);

const members = membersEntries.sort(
	(a, b) => a.data.priority - b.data.priority,
);
const dogLookup = new Map(dogsEntries.map((dog) => [dog.id, dog]));
const getMemberDogs = (member: (typeof members)[number]) =>
	(member.data.dogs ?? [])
		.map((slug) => dogLookup.get(slug.toLowerCase()))
		.filter((dog) => dog !== undefined);
---

<Layout title="Angyalmancsok | Rólunk">
	<div class="text-left">
		<AboutIntro memberCount={members.length} dogCount={dogsEntries.length} />

		{
			chapters.map((chapter, index) => (
				<Chapter
					number={index + 1}
					title={chapter.data.title}
					content={chapter.data.content}
					image={chapter.data.image}
					layout={chapterLayouts[index] ?? "wide"}
				/>
			))
		}

		<section
			aria-labelledby="team-heading"
			class="border-t border-secondary-300 py-16 md:py-24"
		>
			<div class="grid gap-6 md:grid-cols-12 md:gap-x-12">
				<div class="md:col-span-5">
					<p class="font-display text-lg italic text-secondary-700">
						{String(chapters.length + 1).padStart(2, "0")}
					</p>
					<h2
						id="team-heading"
						class="mt-2 font-display text-3xl font-medium tracking-tight text-primary-950 md:text-5xl"
					>
						Csapatunk
					</h2>
				</div>
				<p class="text-lg leading-relaxed text-text-description md:col-span-7 md:self-end">
					Felvezetők és kutyáik: párosok, akik minden héten együtt dolgoznak
					azon, hogy terápiás kutyáinkkal örömet vigyünk az emberek életébe.
				</p>
			</div>

			<div class="mt-16 grid gap-x-12 gap-y-16 md:grid-cols-2">
				{
					members.map((member) => (
						<TeamMember member={member} dogs={getMemberDogs(member)} />
					))
				}
			</div>
		</section>

		<AboutCta />
	</div>
</Layout>
